rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control (RBAC)
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSupervisory() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'administrator' ||
        request.auth.token.role == 'manager'
      );
    }

    function isOwner(resourceData) {
      return isAuthenticated() && (
        resourceData.createdBy == request.auth.uid ||
        resourceData.createdBy == request.auth.token.username ||
        resourceData.salesId == request.auth.uid
      );
    }

    // Quotations & Sales Orders Collection
    match /quotations/{quotationId} {
      allow read, write: if true;
    }

    // Product Catalog Items
    match /items/{itemId} {
      allow read, write: if true;
    }

    // Customer Database & Credit Limits
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // System Users & Roles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Settings
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Activity Audit Logs
    match /activityLogs/{logId} {
      allow read, write: if true;
    }

    // Default Fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
